{
  "name": "@robuust/craft-inertia-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:prepare": "node tests/e2e/prepare.mjs",
    "test:e2e:report": "playwright show-report reports/e2e/step01/playwright",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write tests/e2e/*.ts tests/e2e/*.mjs tsconfig.json package.json",
    "format:check": "prettier --check tests/e2e/*.ts tests/e2e/*.mjs tsconfig.json package.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
