{
    "name": "robuust/craft-inertia",
    "description": "Opt-in public Inertia frontend integration for Craft CMS 6.",
    "type": "craft-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "craftcms/cms": "^6.0.0-alpha.20",
        "inertiajs/inertia-laravel": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Robuust\\CraftInertia\\": "src/"
        }
    },
    "extra": {
        "class": "Robuust\\CraftInertia\\Plugin",
        "handle": "inertia",
        "name": "Inertia",
        "developer": "Robuust",
        "schemaVersion": "1.0.0"
    },
    "config": {
        "sort-packages": true
    }
}
